   <ArchiveAction
      buildConfiguration = "Release"
      revealArchiveInOrganizer = "YES">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Sign, Notarize and Staple"
               scriptText = "#!/bin/bash&#10;set -e&#10;&#10;# Post-archive script: Sign, Notarize, and Staple&#10;# Runs automatically after archiving&#10;&#10;LOG=&quot;/tmp/ImageAlpha-notarize.log&quot;&#10;exec &gt; &quot;$LOG&quot; 2&gt;&amp;1&#10;&#10;echo &quot;=== ImageAlpha Post-Archive: Sign, Notarize, Staple ===&quot;&#10;echo &quot;Started: $(date)&quot;&#10;echo &quot;&quot;&#10;&#10;# Find the app&#10;APP=&quot;$ARCHIVE_PRODUCTS_PATH/Applications/ImageAlpha.app&quot;&#10;if [ ! -d &quot;$APP&quot; ]; then&#10;    APP=&quot;$ARCHIVE_PRODUCTS_PATH/Users/$USER/Applications/ImageAlpha.app&quot;&#10;fi&#10;&#10;if [ ! -d &quot;$APP&quot; ]; then&#10;    echo &quot;ERROR: Could not find ImageAlpha.app&quot;&#10;    osascript -e &apos;display notification &quot;Could not find app in archive&quot; with title &quot;ImageAlpha&quot; subtitle &quot;Notarization Failed&quot;&apos;&#10;    exit 1&#10;fi&#10;&#10;echo &quot;App: $APP&quot;&#10;echo &quot;&quot;&#10;&#10;# Step 1: Sign&#10;echo &quot;=== Step 1: Signing ===&quot;&#10;SCRIPT=&quot;$SRCROOT/sign-for-notarization.sh&quot;&#10;if [ ! -f &quot;$SCRIPT&quot; ]; then&#10;    echo &quot;ERROR: Signing script not found&quot;&#10;    osascript -e &apos;display notification &quot;Signing script not found&quot; with title &quot;ImageAlpha&quot; subtitle &quot;Notarization Failed&quot;&apos;&#10;    exit 1&#10;fi&#10;&quot;$SCRIPT&quot; &quot;$APP&quot;&#10;echo &quot;&quot;&#10;&#10;# Step 2: Create zip for notarization&#10;echo &quot;=== Step 2: Creating zip ===&quot;&#10;ZIP=&quot;/tmp/ImageAlpha-notarize.zip&quot;&#10;rm -f &quot;$ZIP&quot;&#10;ditto -c -k --keepParent &quot;$APP&quot; &quot;$ZIP&quot;&#10;echo &quot;Created: $ZIP&quot;&#10;echo &quot;&quot;&#10;&#10;# Step 3: Submit to notarization&#10;echo &quot;=== Step 3: Submitting to Apple ===&quot;&#10;osascript -e &apos;display notification &quot;Submitting to Apple...&quot; with title &quot;ImageAlpha&quot; subtitle &quot;Notarization in Progress&quot;&apos;&#10;&#10;RESULT=$(xcrun notarytool submit &quot;$ZIP&quot; --keychain-profile &quot;ImageAlpha&quot; --wait 2&gt;&amp;1)&#10;echo &quot;$RESULT&quot;&#10;&#10;if echo &quot;$RESULT&quot; | grep -q &quot;status: Accepted&quot;; then&#10;    echo &quot;&quot;&#10;    echo &quot;=== Step 4: Stapling ticket ===&quot;&#10;    xcrun stapler staple &quot;$APP&quot;&#10;    echo &quot;&quot;&#10;    echo &quot;=== SUCCESS ===&quot;&#10;    echo &quot;App is signed, notarized, and stapled!&quot;&#10;    echo &quot;Location: $APP&quot;&#10;    osascript -e &apos;display notification &quot;App is ready for distribution!&quot; with title &quot;ImageAlpha&quot; subtitle &quot;Notarization Complete&quot; sound name &quot;Glass&quot;&apos;&#10;else&#10;    echo &quot;&quot;&#10;    echo &quot;=== NOTARIZATION FAILED ===&quot;&#10;    osascript -e &apos;display notification &quot;Check /tmp/ImageAlpha-notarize.log&quot; with title &quot;ImageAlpha&quot; subtitle &quot;Notarization Failed&quot; sound name &quot;Basso&quot;&apos;&#10;    exit 1&#10;fi&#10;&#10;# Cleanup&#10;rm -f &quot;$ZIP&quot;&#10;echo &quot;&quot;&#10;echo &quot;Finished: $(date)&quot;&#10;"
               shellToInvoke = "/bin/bash">
               <EnvironmentBuildable>
                  <BuildableReference
