                     BuildableName = "ImageAlpha.app"
                     BlueprintName = "ImageAlpha"
                     ReferencedContainer = "container:ImageAlpha.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
   </ArchiveAction>
</Scheme>
