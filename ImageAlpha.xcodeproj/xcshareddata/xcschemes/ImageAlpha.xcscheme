            <ActionContent
               title = "Sign for Notarization"
               scriptText = "#!/bin/bash&#10;&#10;# Post-archive script to sign the app for notarization&#10;# The archive is at: $ARCHIVE_PATH&#10;# The app is at: $ARCHIVE_PRODUCTS_PATH/Applications/ImageAlpha.app&#10;&#10;APP=&quot;$ARCHIVE_PRODUCTS_PATH/Applications/ImageAlpha.app&quot;&#10;&#10;if [ ! -d &quot;$APP&quot; ]; then&#10;    # Try alternate path&#10;    APP=&quot;$ARCHIVE_PRODUCTS_PATH/Users/$USER/Applications/ImageAlpha.app&quot;&#10;fi&#10;&#10;if [ ! -d &quot;$APP&quot; ]; then&#10;    echo &quot;ERROR: Could not find ImageAlpha.app in archive&quot;&#10;    echo &quot;ARCHIVE_PATH: $ARCHIVE_PATH&quot;&#10;    echo &quot;ARCHIVE_PRODUCTS_PATH: $ARCHIVE_PRODUCTS_PATH&quot;&#10;    exit 1&#10;fi&#10;&#10;SCRIPT=&quot;$SRCROOT/sign-for-notarization.sh&quot;&#10;&#10;if [ ! -f &quot;$SCRIPT&quot; ]; then&#10;    echo &quot;ERROR: Signing script not found at $SCRIPT&quot;&#10;    exit 1&#10;fi&#10;&#10;echo &quot;=== Running post-archive signing script ===&quot;&#10;echo &quot;App: $APP&quot;&#10;&#10;&quot;$SCRIPT&quot; &quot;$APP&quot;&#10;&#10;echo &quot;&quot;&#10;echo &quot;=== Signing complete ===&quot;&#10;echo &quot;You can now distribute the archive from Xcode Organizer&quot;&#10;"
               shellToInvoke = "/bin/bash">
